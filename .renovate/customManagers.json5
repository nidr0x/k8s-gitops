{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  customManagers: [
    {
      customType: "regex",
      description: "Process annotated dependencies",
      managerFilePatterns: [
        "/(^|/).+\\.env$/",
        "/(^|/).+\\.sh$/",
        "/(^|/).+\\.ya?ml(?:\\.j2)?$/",
      ],
      matchStrings: [
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( repository=(?<registryUrl>\\S+))?( versioning=(?<versioning>\\S+))?\\n.+(:\\s|=)(&\\S+\\s)?(?<currentValue>\\S+)",
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( versioning=(?<versioning>\\S+))?\\n.+/(?<currentValue>(v|\\d)[^/]+)",
      ],
      datasourceTemplate: "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}",
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}",
    },
    {
      customType: "regex",
      description: "Process the pinned LocalThings source commit",
      managerFilePatterns: [
        "/(^|/)kubernetes/main/apps/homeassistant/localthings/install\\.py$/",
      ],
      matchStrings: [
        '# renovate: datasource=git-refs depName=mbillow/localthings\\nCOMMIT = \\"(?<currentDigest>[0-9a-f]{40})\\"',
      ],
      currentValueTemplate: "main",
      depNameTemplate: "mbillow/localthings",
      packageNameTemplate: "https://github.com/mbillow/localthings",
      datasourceTemplate: "git-refs",
      versioningTemplate: "git",
    },
    {
      customType: "regex",
      description: "Process the LocalThings Python dependency",
      managerFilePatterns: [
        "/(^|/)kubernetes/main/apps/homeassistant/localthings/install\\.py$/",
      ],
      matchStrings: [
        '# renovate: datasource=pypi depName=smartthings-local\\nDEPENDENCY = \\"smartthings-local==(?<currentValue>[^\\"\\s]+)\\"',
      ],
      depNameTemplate: "smartthings-local",
      datasourceTemplate: "pypi",
      versioningTemplate: "pep440",
    },
    {
      customType: "regex",
      description: "Process the pinned LocalThings source commit",
      managerFilePatterns: [
        "/(^|/)kubernetes/main/apps/homeassistant/localthings/install\\.py$/",
      ],
      matchStrings: [
        '# renovate: datasource=git-refs depName=mbillow/localthings\\nCOMMIT = \\"(?<currentDigest>[0-9a-f]{40})\\"',
      ],
      currentValueTemplate: "main",
      depNameTemplate: "mbillow/localthings",
      packageNameTemplate: "https://github.com/mbillow/localthings",
      datasourceTemplate: "git-refs",
      versioningTemplate: "git",
    },
    {
      customType: "regex",
      description: "Process the LocalThings Python dependency",
      managerFilePatterns: [
        "/(^|/)kubernetes/main/apps/homeassistant/localthings/install\\.py$/",
      ],
      matchStrings: [
        '# renovate: datasource=pypi depName=smartthings-local\\nDEPENDENCY = \\"smartthings-local==(?<currentValue>[^\\"\\s]+)\\"',
      ],
      depNameTemplate: "smartthings-local",
      datasourceTemplate: "pypi",
      versioningTemplate: "pep440",
    },
  ],
}
